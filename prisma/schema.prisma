// Prisma schema for EDA Studio
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Store analysis sessions for history/sharing
model AnalysisSession {
  id           String   @id @default(cuid())
  fileName     String
  rowCount     Int
  colCount     Int
  numericCols  Int
  catCols      Int
  missingRate  Float
  patternCount Int

  // Stored as JSON blobs for flexibility
  colInfoJson    Json?
  patternsJson   Json?
  corrMatrixJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("analysis_sessions")
}

// Optional: track uploaded datasets
model Dataset {
  id        String   @id @default(cuid())
  name      String
  sizeBytes Int?
  mimeType  String?
  rowCount  Int?
  colCount  Int?

  sessions AnalysisSession[]

  createdAt DateTime @default(now())

  @@map("datasets")
}
